# AI Company - Environment Configuration
# Copy this file to .env and fill in your values

# ==============================================
# AI PROVIDER SETTINGS
# ==============================================

# Primary AI Provider: gemini, claude, gpt, mock
AI_PRIMARY_PROVIDER=gemini

# Fallback providers (comma-separated)
AI_FALLBACK_PROVIDERS=mock

# ==============================================
# GEMINI API (Primary)
# ==============================================

# Google AI Studio에서 API 키 발급
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini 모델 선택
# gemini-1.5-flash (빠름, 저렴), gemini-1.5-pro (고성능), gemini-pro
GEMINI_MODEL=gemini-1.5-flash

# ==============================================
# CLAUDE API (Backup)
# ==============================================

# Anthropic Console에서 API 키 발급
# https://console.anthropic.com/
CLAUDE_API_KEY=

# Claude 모델 선택
# claude-3-opus, claude-3-sonnet, claude-3-haiku
CLAUDE_MODEL=claude-3-sonnet

# ==============================================
# OPENAI API (Backup)
# ==============================================

# OpenAI Platform에서 API 키 발급
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# GPT 모델 선택
# gpt-4, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4-turbo

# ==============================================
# AI SETTINGS
# ==============================================

# 기본 온도 (0.0 ~ 1.0)
AI_DEFAULT_TEMPERATURE=0.7

# 기본 최대 토큰 수
AI_DEFAULT_MAX_TOKENS=4096

# API 타임아웃 (ms)
AI_TIMEOUT=60000

# 재시도 횟수
AI_RETRY_ATTEMPTS=3

# ==============================================
# LOGGING
# ==============================================

# 로깅 활성화
ENABLE_LOGGING=true

# 로그 보관 수
LOG_RETENTION=1000

# 로그 레벨: debug, info, warn, error
LOG_LEVEL=info

# ==============================================
# COMPANY SETTINGS
# ==============================================

# 회사 이름
COMPANY_NAME=AI Nexus Corporation

# 최대 동시 태스크 수
MAX_CONCURRENT_TASKS=10

# 워크플로우 타임아웃 (ms)
WORKFLOW_TIMEOUT=300000
